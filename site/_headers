# Cross-origin isolation: required for SharedArrayBuffer once the wasm-threads
# build lands; harmless (and forward-compatible) for today's single-thread engine.
#
# The CSP is the page's promise made enforceable: everything loads from this origin, no
# foreign script can run, and no fetch/XHR can carry anything OUT — which is the pitch
# ("nothing leaves the tab") as policy. Notes on the loose spots:
#   * style-src 'unsafe-inline': the page uses an inline <style> block and style= attrs.
#   * 'unsafe-eval' beside 'wasm-unsafe-eval': Safari only learned the wasm-specific
#     token in 16.4; without the fallback, older iOS that runs the engine today would
#     brick. The load-bearing protections here are the SOURCE restrictions, not eval bans.
#   * media-src blob: — synthesized audio and MP3 downloads are object URLs.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# The page's own scripts and markup must never be served stale: Pages' default
# max-age=14400 let a fresh index.html pair with a four-hour-old viz.js, which
# renders every newer visualization container as an empty box. no-cache still
# permits ETag revalidation, so repeat visits stay cheap. Pages splats must end
# a pattern, so the site files are listed literally.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/viz.js
  Cache-Control: no-cache
/loader.js
  Cache-Control: no-cache
/engine-worker.js
  Cache-Control: no-cache
/kernel-worker.js
  Cache-Control: no-cache
/chrome.js
  Cache-Control: no-cache
/sha256.js
  Cache-Control: no-cache
/model-manifest.js
  Cache-Control: no-cache

/pkg/*
  Cache-Control: no-cache

/pkg-serial/*
  Cache-Control: no-cache

# The vendored MP3 encoder is versioned by content and effectively immutable.
/vendor/*
  Cache-Control: public, max-age=604800
