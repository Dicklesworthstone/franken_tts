# bv (beads viewer) local config and caches
.bv/

# Truth-pack snapshots: hashes are committed (docs/truth-pack/MANIFEST.sha256), bytes are not —
# EXCEPT the two small redistribution-safe files ftts-cli include_str!s at COMPILE time (the pin
# assertion config and the Apache attribution text). Without them a fresh clone cannot build the
# binary at all; their bytes are manifest-verified (2e714c78… / a44a6081…) so the pin stays honest.
docs/truth-pack/snapshots/*
!docs/truth-pack/snapshots/hf/
docs/truth-pack/snapshots/hf/*
!docs/truth-pack/snapshots/hf/config.json
!docs/truth-pack/snapshots/gh/
docs/truth-pack/snapshots/gh/*
!docs/truth-pack/snapshots/gh/LICENSE

# Python bytecode from the verification harnesses
__pycache__/
*.pyc
.oracle-venv/

# Playwright and its browser downloads back the real-browser gate in site/harness/;
# they are a developer dependency, never part of the shipped site.
node_modules/
package-lock.json

# === multi-repo ephemeral patterns 2026-08-10 ===
# Eidetic Engine local runtime memory (machine-local DB/WAL/locks)
.ee/
# NTM agent swarm runtime (logs, pids, rate limits)
.ntm/
# Cloudflare Wrangler CLI local state
.wrangler/
# Claude Code local session state (nothing tracked here)
.claude/
# Local one-off audio probe dumps from make-video / say experiments
/test.m4a
# br fsqlite-ns VFS sidecars — per-machine runtime state, like -wal/-shm
.beads/beads.db-fsqlite-ns-*
# Recoverable Beads write-lock snapshots moved aside when stale
.beads/.write.lock.stale-*
# git-repo-janitor skill scratch workspace
.repo_janitor_workspace/
# Skill-loop progress scratch
.skill-loop-progress.md
.skill-loop-progress-*.md
# Local screen-recording of the playground; the site does not reference it
/demo.mp4
